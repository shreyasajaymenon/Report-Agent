# OpenAI API Key (used as primary/fallback if OpenRouter not used)
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter API Keys (rotates automatically if multiple are provided)
OPENROUTER_API_KEY_1=your_openrouter_api_key_here
OPENROUTER_API_KEY_2=your_secondary_openrouter_api_key_here

# LangSearch API Key (required for web scraping context)
LANGSEARCH_API_KEY_1=your_langsearch_api_key_here
